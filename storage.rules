rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isApprovedFollower(authorUid) {
      return signedIn() &&
        !isBlocked(authorUid, request.auth.uid) &&
        firestore.exists(/databases/(default)/documents/users/$(authorUid)/followers/$(request.auth.uid));
    }

    function isBlocked(leftUid, rightUid) {
      return firestore.exists(/databases/(default)/documents/users/$(leftUid)/blocks/$(rightUid)) ||
        firestore.exists(/databases/(default)/documents/users/$(rightUid)/blocks/$(leftUid));
    }

    function momentAppearsInWander(momentId) {
      return signedIn() &&
        firestore.get(/databases/(default)/documents/moments/$(momentId)).data.appearInWander == true;
    }

    match /users/{uid}/avatar/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() &&
        request.auth.uid == uid &&
        (
          request.resource == null ||
          (
            request.resource.size < 5 * 1024 * 1024 &&
            request.resource.contentType.matches('image/(jpeg|png|heic|heif|webp)')
          )
        );
    }

    match /users/{uid}/moments/{momentId}/{allPaths=**} {
      allow read: if signedIn() && !isBlocked(uid, request.auth.uid) && (request.auth.uid == uid || isApprovedFollower(uid) || momentAppearsInWander(momentId));
      allow write: if signedIn() &&
        request.auth.uid == uid &&
        (
          request.resource == null ||
          (
            request.resource.size < 25 * 1024 * 1024 &&
            request.resource.contentType.matches('image/(jpeg|jpg|png|heic|heif|webp)')
          )
        );
    }
  }
}
