rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isApprovedFollower(authorUid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(authorUid)/followers/$(request.auth.uid));
    }

    function canSeeMoment(authorUid) {
      return signedIn() && (request.auth.uid == authorUid || isApprovedFollower(authorUid));
    }

    match /users/{uid} {
      allow read, write: if isSelf(uid);

      match /following/{targetUid} {
        allow read: if isSelf(uid);
        allow create, update, delete: if isSelf(uid) || isSelf(targetUid);
      }

      match /followers/{followerUid} {
        allow read: if isSelf(uid) || isSelf(followerUid);
        allow create, update: if isSelf(uid);
        allow delete: if isSelf(uid) || isSelf(followerUid);
      }

      match /followRequests/{requesterUid} {
        allow read: if isSelf(uid) || isSelf(requesterUid);
        allow create: if isSelf(requesterUid);
        allow update, delete: if isSelf(uid) || isSelf(requesterUid);
      }

      match /outgoingFollowRequests/{targetUid} {
        allow read, create, update: if isSelf(uid);
        allow delete: if isSelf(uid) || isSelf(targetUid);
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if isSelf(uid);
        allow create: if signedIn() &&
          request.auth.uid == request.resource.data.actorUid &&
          get(/databases/$(database)/documents/moments/$(request.resource.data.momentId)).data.authorUid == uid &&
          existsAfter(/databases/$(database)/documents/moments/$(request.resource.data.momentId)/notes/$(notificationId)) &&
          getAfter(/databases/$(database)/documents/moments/$(request.resource.data.momentId)/notes/$(notificationId)).data.authorUid == request.auth.uid;
      }

      match /pushTokens/{tokenId} {
        allow read, write: if isSelf(uid);
      }

      match /kept/{momentId} {
        allow read, write: if isSelf(uid);
      }

      match /saved/{momentId} {
        allow read, write: if isSelf(uid);
      }
    }

    match /publicUsers/{uid} {
      allow read: if signedIn();
      allow write: if isSelf(uid);
    }

    match /moments/{momentId} {
      allow read: if canSeeMoment(resource.data.authorUid) ||
        (signedIn() && resource.data.appearInWander == true);
      allow create: if signedIn() && request.auth.uid == request.resource.data.authorUid;
      allow update: if signedIn() && (
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['keptCount']) &&
          request.resource.data.keptCount >= 0 &&
          (
            request.resource.data.keptCount == resource.data.keptCount + 1 ||
            request.resource.data.keptCount == resource.data.keptCount - 1
          )
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['noteCount']) &&
          request.resource.data.noteCount == resource.data.noteCount + 1
        )
      );
      allow delete: if signedIn() && request.auth.uid == resource.data.authorUid;

      match /back/{detailId} {
        allow read: if signedIn() &&
          request.auth.uid == get(/databases/$(database)/documents/moments/$(momentId)).data.authorUid;
        allow create: if signedIn() &&
          request.auth.uid == get(/databases/$(database)/documents/moments/$(momentId)).data.authorUid;
        allow update: if signedIn() &&
          request.auth.uid == get(/databases/$(database)/documents/moments/$(momentId)).data.authorUid;
        allow delete: if signedIn() &&
          request.auth.uid == get(/databases/$(database)/documents/moments/$(momentId)).data.authorUid;
      }

      match /keeps/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == uid;
        allow delete: if signedIn() && (
          request.auth.uid == uid ||
          request.auth.uid == get(/databases/$(database)/documents/moments/$(momentId)).data.authorUid
        );
        allow update: if false;
      }

      match /notes/{noteId} {
        allow read: if canSeeMoment(get(/databases/$(database)/documents/moments/$(momentId)).data.authorUid);
        allow create: if signedIn() &&
          canSeeMoment(get(/databases/$(database)/documents/moments/$(momentId)).data.authorUid) &&
          request.auth.uid == request.resource.data.authorUid;
        allow update: if signedIn() && request.auth.uid == resource.data.authorUid;
        allow delete: if signedIn() && (
          request.auth.uid == resource.data.authorUid ||
          request.auth.uid == get(/databases/$(database)/documents/moments/$(momentId)).data.authorUid
        );
      }
    }
  }
}
